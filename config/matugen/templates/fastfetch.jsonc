{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "right": 4
    },
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.secondary.default.hex}}",
      "3": "{{colors.tertiary.default.hex}}",
      "4": "{{colors.primary_container.default.hex}}",
      "5": "{{colors.secondary_container.default.hex}}",
      "6": "{{colors.tertiary_container.default.hex}}",
      "7": "{{colors.surface_container_high.default.hex}}",
      "8": "{{colors.on_surface.default.hex}}"
    }
  },
  "display": {
    "separator": " ─ ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.tertiary.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}",
      "separator": "{{colors.outline.default.hex}}"
    },
    "brightColor": true
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "localip",
    "bluetooth",
    "sound",
    "datetime"
  ]
}
