# Super = Win 键。快捷键速查：~/.config/sway/快捷键.md
set $mod Mod4
set $term kitty
set $menu exec ~/.config/rofi/launcher.sh
font pango:Sans 10

# 外屏在左，内屏在右；沿用现有桌面的 125% 缩放。
output eDP-1 mode 1920x1080@165.008Hz scale 1.25 pos 2048 0
# Prefer crisp pixels when a client buffer needs resampling.
output eDP-1 scale_filter nearest
output HDMI-A-1 mode 2560x1440@143.999Hz scale 1.25 pos 0 0
output * adaptive_sync off
include ~/.config/sway/wallpaper.conf

input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 35
}
input type:touchpad {
    tap enabled
    dwt enabled
    natural_scroll enabled
    middle_emulation enabled
}
input type:pointer accel_profile flat
seat * xcursor_theme fireflys-pixel-cursors 32
focus_follows_mouse no
mouse_warping output
workspace_auto_back_and_forth yes
floating_modifier $mod normal
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 0
smart_borders on
client.focused #89b4fa #89b4fa #1e1e2e
client.unfocused #313244 #1e1e2e #cdd6f4
client.focused_inactive #45475a #1e1e2e #cdd6f4
client.urgent #f38ba8 #f38ba8 #1e1e2e
include ~/.config/sway/colors.conf
for_window [app_id="termfloat"] floating enable, resize set 960 600
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable

include /etc/sway/config.d/*
# Sway exports the effective seat0 theme/size; sync at login and on reload.
exec_always ~/.config/sway/sync-xcursor.py > ~/.local/state/sway/xcursor.log 2>&1
exec fcitx5 -d
exec ~/.config/waybar/sway/launch_waybar.sh 2
# Plain exec runs once at login, not again on config reload.
exec ~/.config/sway/wallpaper.py startup
bindsym $mod+Ctrl+t exec ~/.config/sway/wallpaper.py gui

# 启动 / 关闭 / 锁屏
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec kitty --class termfloat
bindsym $mod+d $menu
bindsym $mod+space $menu
bindsym $mod+b exec firefox
bindsym $mod+e exec nautilus
bindsym $mod+q kill
bindsym Mod1+F4 kill
bindsym $mod+Escape exec hyprlock
bindsym $mod+Shift+x exec hyprlock
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m '退出 Sway？未保存的工作可能丢失。' -B '退出登录' 'swaymsg exit'

# 方向键和 Vim 方向键均可；Shift 移动窗口。
bindsym $mod+Left focus left
bindsym $mod+Shift+Left move left
bindsym $mod+Down focus down
bindsym $mod+Shift+Down move down
bindsym $mod+Up focus up
bindsym $mod+Shift+Up move up
bindsym $mod+Right focus right
bindsym $mod+Shift+Right move right
bindsym $mod+h focus left
bindsym $mod+Shift+h move left
bindsym $mod+j focus down
bindsym $mod+Shift+j move down
bindsym $mod+k focus up
bindsym $mod+Shift+k move up
bindsym $mod+l focus right
bindsym $mod+Shift+l move right
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Page_Up workspace prev
bindsym $mod+Page_Down workspace next
bindsym $mod+Ctrl+Left focus output left
bindsym $mod+Ctrl+Right focus output right
bindsym $mod+Ctrl+Shift+Left move container to output left
bindsym $mod+Ctrl+Shift+Right move container to output right

# 布局
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+space focus mode_toggle
bindsym $mod+v splitv
bindsym $mod+backslash splith
bindsym $mod+w layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+t layout toggle split
bindsym $mod+minus move scratchpad
bindsym $mod+equal scratchpad show
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym Left resize shrink width 20 px
    bindsym Right resize grow width 20 px
    bindsym Up resize shrink height 20 px
    bindsym Down resize grow height 20 px
    bindsym h resize shrink width 20 px
    bindsym l resize grow width 20 px
    bindsym k resize shrink height 20 px
    bindsym j resize grow height 20 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# 音量 / 亮度 / 播放
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl --min-value=1 set 5%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

# 截图保存到 Pictures/Screenshots，并复制到剪贴板。
bindsym Print exec ~/.config/sway/screenshot.sh full
bindsym $mod+Shift+s exec ~/.config/sway/screenshot.sh region
