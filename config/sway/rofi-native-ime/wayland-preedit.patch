+static void wayland_seat_clear_preedit(wayland_seat *self) {
+  if (!self->preedit_active) {
+    return;
+  }
+  textbox *tb = rofi_view_get_active_text();
+  if (tb != NULL) {
+    textbox_text(tb, self->preedit_base ? self->preedit_base : "");
+    textbox_cursor(tb, self->preedit_cursor);
+  }
+  g_clear_pointer(&self->preedit_base, g_free);
+  self->preedit_active = FALSE;
+}
