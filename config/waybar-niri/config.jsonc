{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/cava",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
    "bluetooth",
    "network",
    "tray",
    "group/power-controls"
  ],

  "group/power-controls": {
    "orientation": "horizontal",
    "modules": [
      "custom/platform-profile",
      "custom/powermenu"
    ]
  },

  "niri/workspaces": {
    "format": "{index}",
    "disable-scroll": true,
    "all-outputs": true
  },

  "niri/window": {
    "format": "{}",
    "max-length": 40,
    "rewrite": {
      "(.*) — Mozilla Firefox": " $1",
      "(.*) - Google Chrome": " $1",
      "(.*) - Visual Studio Code": "󰨞 $1"
    }
  },

  "clock": {
    "interval": 1,
    "format": " {:%H:%M}",
    "format-alt": " {:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode"
    }
  },

//  "custom/cava": {
 //   "exec": "~/.config/waybar/sway/Cava.sh",
 //   "tooltip": false
 // },

  "pulseaudio": {
    "scroll-step": 1,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    // "states": { "warning": 85 },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": false,
    "format-bluetooth": "{icon}  {volume}%",
    "format-icons": {
            "headphone": "",
            "hands-free": "󰘂",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
    }
  },

  "cpu": {
    "interval": 2,
    "format": "󰻠 {usage}%"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "states": { "warning": 85 }
  },

  "custom/platform-profile": {
    "exec": "~/.config/waybar/niri/scripts/platform-profile.sh --status",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.config/waybar/niri/scripts/platform-profile.sh --menu",
    "tooltip": true
  },

  "battery": {
    "interval": 10,
    "states": { "warning": 20, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-full": "{icon} Full",
    "tooltip": false,
    "format-icons": ["", "", "", "", ""]
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },

  "network": {
    "interval": 2,
    "format-wifi": " {essid}",
    "format-ethernet": " {ifname}",
    "format-linked": " {essid} (No IP)",
    "format-disconnected": "󰌙 Disconnected",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/powermenu": {
    "format": "󰐥",
    "on-click": "~/.config/waybar/niri/scripts/power-menu.sh",
    "tooltip-format": "电源选项"
  }
}
